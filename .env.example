# ===== Django =====
SECRET_KEY=genera-una-clave-larga-aleatoria
DEBUG=True

# ===== Documentación (Swagger / Redoc) =====
# Si se omite, toma el valor de DEBUG. En produccion dejar en False:
# con la bandera apagada las rutas de docs no existen y el esquema
# no se genera en runtime.
DOCS_ENABLED=True

# ===== Base de datos (MySQL) =====
DB_ENGINE=django.db.backends.mysql
DB_NAME=archi
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306
